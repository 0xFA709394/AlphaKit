# ====================================
# AlphaKit 环境配置
# 复制为 .env 后按需修改;php bin/alphakit key:generate 生成密钥
# ====================================

APP_NAME=AlphaKit
APP_ENV=local
APP_DEBUG=true
APP_TIMEZONE=Asia/Shanghai
APP_URL=http://127.0.0.1:8000

# 数据库:sqlite(默认,零配置) / mysql
DB_CONNECTION=sqlite
# DB_SQLITE_PATH=database/database.sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=alphakit
# DB_USERNAME=root
# DB_PASSWORD=

# 缓存:file / redis / array
CACHE_DRIVER=file
# REDIS_HOST=127.0.0.1
# REDIS_PORT=6379

# 队列:database / sync
QUEUE_DRIVER=database

# JWT 密钥(key:generate 生成,生产必改)
JWT_SECRET=
JWT_TTL=7200

# 日志级别:debug/info/notice/warning/error
LOG_LEVEL=debug
